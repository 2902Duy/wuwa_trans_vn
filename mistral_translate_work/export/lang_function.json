    "category": "ui"
  },
  {
    "database": "lang_function.db",
    "table": "FunctionCondition",
    "primary_key_column": "Id",
    "primary_key": "15",
    "column": "Content",
    "source_en": "Zero Point Research Station",
    "source_hash": "5dcf627030c0e493bf81ad5322123e96f9e3201a",
    "category": "ui"
  },
  {
    "database": "lang_function.db",
    "table": "FunctionCondition",
    "primary_key_column": "Id",
    "primary_key": "16",
    "column": "Content",
    "source_en": "Large-scale underground experiment center built before the Lament. The well below it attain the depth reaching the mohoroviic discontinuity. Secrets and unknown knowledge await you there.",
    "source_hash": "6a136899a31c373cecaf768f5fa26e2d2166eda6",
    "category": "ui"
  },
  {
