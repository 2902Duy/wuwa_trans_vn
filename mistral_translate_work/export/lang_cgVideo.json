    "primary_key_column": "Id",
    "primary_key": "1",
    "column": "Content",
    "source_en": "Rage on and on……",
    "source_hash": "522db125714c443337144c23dc4c843c2f347533",
    "category": "dialogue"
  },
  {
    "database": "lang_cgVideo.db",
    "table": "VideoCaption",
    "primary_key_column": "Id",
    "primary_key": "2",
    "column": "Content",
    "source_en": "Rage on and on……",
    "source_hash": "522db125714c443337144c23dc4c843c2f347533",
    "category": "dialogue"
  },
  {
    "database": "lang_cgVideo.db",
    "table": "VideoCaption",
    "primary_key_column": "Id",
    "primary_key": "3",
    "column": "Content",
    "source_en": "Rage on and on……",
    "source_hash": "522db125714c443337144c23dc4c843c2f347533",
    "category": "dialogue"
  },
  {
    "database": "lang_cgVideo.db",
    "table": "VideoCaption",
    "primary_key_column": "Id",
    "primary_key": "4",
    "column": "Content",
    "source_en": "Rage on and on……",
    "source_hash": "522db125714c443337144c23dc4c843c2f347533",
    "category": "dialogue"
  },
  {
    "database": "lang_cgVideo.db",
    "table": "VideoCaption",
    "primary_key_column": "Id",
    "primary_key": "5",
    "column": "Content",
    "source_en": "Rage on and on……",
    "source_hash": "522db125714c443337144c23dc4c843c2f347533",
    "category": "dialogue"
  },
  {
    "database": "lang_cgVideo.db",
    "table": "VideoCaption",
    "primary_key_column": "Id",
    "primary_key": "6",
    "column": "Content",
    "source_en": "Rage on and on……",
    "source_hash": "522db125714c443337144c23dc4c843c2f347533",
    "category": "dialogue"
  },
  {
    "database": "lang_cgVideo.db",
    "table": "VideoCaption",
    "primary_key_column": "Id",
    "primary_key": "7",
    "column": "Content",
    "source_en": "Rage on and on……",
    "source_hash": "522db125714c443337144c23dc4c843c2f347533",
    "category": "dialogue"
  },
  {
    "database": "lang_cgVideo.db",
    "table": "VideoCaption",
    "primary_key_column": "Id",
    "primary_key": "8",
    "column": "Content",
    "source_en": "Rage on and on……",
    "source_hash": "522db125714c443337144c23dc4c843c2f347533",
    "category": "dialogue"
  },
  {
    "database": "lang_cgVideo.db",
    "table": "VideoCaption",
    "primary_key_column": "Id",
    "primary_key": "9",
    "column": "Content",
    "source_en": "Rage on and on……",
    "source_hash": "522db125714c443337144c23dc4c843c2f347533",
    "category": "dialogue"
  },
  {
    "database": "lang_cgVideo.db",
    "table": "VideoCaption",
    "primary_key_column": "Id",
    "primary_key": "10",
    "column": "Content",
    "source_en": "The story I am about to tell you happened a long long time ago……",
    "source_hash": "368cafb58a9950be43b951d5b3128a7c4f769190",
    "category": "dialogue"
  },
  {
    "database": "lang_cgVideo.db",
    "table": "VideoCaption",
    "primary_key_column": "Id",
    "primary_key": "11",
    "column": "Content",
    "source_en": "The catastrophe by the name of \"Lament\" permeates the world in a disjointed manner.",
    "source_hash": "50735198a88e6a83a478d5f2333bf87261317bca",
    "category": "dialogue"
  },
  {
    "database": "lang_cgVideo.db",
    "table": "VideoCaption",
    "primary_key_column": "Id",
    "primary_key": "12",
    "column": "Content",
    "source_en": "Mankind is lost in despair,",
    "source_hash": "fcf67bb41b156d42441b9958383d2af4866f68f7",
    "category": "dialogue"
  },
  {
    "database": "lang_cgVideo.db",
    "table": "VideoCaption",
    "primary_key_column": "Id",
    "primary_key": "13",
    "column": "Content",
    "source_en": "But is also reborn in the silence.",
    "source_hash": "408bbdd16907aca9b345a1c1dafb35e68f47a56f",
    "category": "dialogue"
  },
  {
    "database": "lang_cgVideo.db",
    "table": "VideoCaption",
    "primary_key_column": "Id",
    "primary_key": "14",
    "column": "Content",
    "source_en": "A newborn accompanied by risk and hope.",
    "source_hash": "768a5f80419664d96a602ef02f78491d9b25afd3",
    "category": "dialogue"
  },
  {
    "database": "lang_cgVideo.db",
    "table": "VideoCaption",
    "primary_key_column": "Id",
    "primary_key": "15",
    "column": "Content",
    "source_en": "The Calamons ravaged the lands.",
    "source_hash": "2764775feaccc61acd497713f7896fa10aceda96",
    "category": "dialogue"
  },
  {
    "database": "lang_cgVideo.db",
    "table": "VideoCaption",
    "primary_key_column": "Id",
    "primary_key": "16",
    "column": "Content",
    "source_en": "Mankind thirsts for the light on top of the ruins of chaos and strife.",
    "source_hash": "f1d13e05c98598d2e2077c31f5312d1b1d8a26a6",
    "category": "dialogue"
  },
  {
    "database": "lang_cgVideo.db",
    "table": "VideoCaption",
    "primary_key_column": "Id",
    "primary_key": "17",
    "column": "Content",
    "source_en": "The shimmering light that pierces the dark tides,",
    "source_hash": "d27420d038cf85332cfbca43171ffc3871f2c2a9",
    "category": "dialogue"
  },
  {
    "database": "lang_cgVideo.db",
    "table": "VideoCaption",
    "primary_key_column": "Id",
    "primary_key": "18",
    "column": "Content",
    "source_en": "connecting to the resonance of life.",
    "source_hash": "fe78d8a72d32d69b3c6810cbb5812570ecf1b0f4",
    "category": "dialogue"
  },
  {
    "database": "lang_cgVideo.db",
    "table": "VideoCaption",
    "primary_key_column": "Id",
    "primary_key": "19",
    "column": "Content",
    "source_en": "Thus, they were born.",
    "source_hash": "98a95fe399ece3018ed47b8c7a0a297d45822c38",
    "category": "dialogue"
  },
  {
    "database": "lang_cgVideo.db",
    "table": "VideoCaption",
    "primary_key_column": "Id",
    "primary_key": "20",
    "column": "Content",
    "source_en": "\"Resonators\" tasked with a mission,",
    "source_hash": "d637ea5bbff72687f4af0a51257bfb3733d73906",
    "category": "dialogue"
  },
  {
    "database": "lang_cgVideo.db",
    "table": "VideoCaption",
    "primary_key_column": "Id",
    "primary_key": "21",
    "column": "Content",
    "source_en": "Grasping a dim light of hope.",
    "source_hash": "5d9806118712e58523db44661eacff81cc38bea6",
    "category": "dialogue"
  },
  {
    "database": "lang_cgVideo.db",
    "table": "VideoCaption",
    "primary_key_column": "Id",
    "primary_key": "22",
    "column": "Content",
    "source_en": "Waving off the prolonging gloom.",
    "source_hash": "c6f33ea2f7a33d705ca93d482e9e6fc807d5f1dc",
    "category": "dialogue"
  },
  {
    "database": "lang_cgVideo.db",
    "table": "VideoCaption",
    "primary_key_column": "Id",
    "primary_key": "23",
    "column": "Content",
    "source_en": "Attempting to shatter the hotbed of disasters.",
    "source_hash": "21c9189963fb16c2e90c8b5d46e61ffc3ee3c59c",
    "category": "dialogue"
  },
  {
    "database": "lang_cgVideo.db",
    "table": "VideoCaption",
    "primary_key_column": "Id",
    "primary_key": "24",
    "column": "Content",
    "source_en": "Only the whistling winter wind,",
    "source_hash": "ef280dd50f161a36a3b3fee89abe75683f5cc9bb",
    "category": "dialogue"
  },
  {
    "database": "lang_cgVideo.db",
    "table": "VideoCaption",
    "primary_key_column": "Id",
    "primary_key": "25",
    "column": "Content",
    "source_en": "Is the song of their victories.",
    "source_hash": "d0bd596968620208073f16e14ebb53d75e27f1da",
    "category": "dialogue"
  },
  {
    "database": "lang_cgVideo.db",
    "table": "VideoCaption",
    "primary_key_column": "Id",
    "primary_key": "26",
    "column": "Content",
    "source_en": "Yet, the flames of destruction has been rekindled.",
    "source_hash": "5aabb3d7a03394d18f6a0dbe812f6088cdb147b5",
    "category": "dialogue"
  },
  {
    "database": "lang_cgVideo.db",
    "table": "VideoCaption",
    "primary_key_column": "Id",
    "primary_key": "27",
    "column": "Content",
    "source_en": "The devastated land wails again.",
    "source_hash": "46a885fc0c3e2512e373ae52547a9874aceecd75",
    "category": "dialogue"
  },
  {
    "database": "lang_cgVideo.db",
    "table": "VideoCaption",
    "primary_key_column": "Id",
    "primary_key": "28",
    "column": "Content",
    "source_en": "The dark tides that lurk within the world,",
    "source_hash": "455516d13c8915ee5f78267b1ad70e44b5748fca",
    "category": "dialogue"
  },
  {
    "database": "lang_cgVideo.db",
    "table": "VideoCaption",
    "primary_key_column": "Id",
    "primary_key": "29",
    "column": "Content",
    "source_en": "A new storm is brewing.",
    "source_hash": "adf88b64e914f42cccd354277221caef7cadf3c2",
    "category": "dialogue"
  },
  {
    "database": "lang_cgVideo.db",
    "table": "VideoCaption",
    "primary_key_column": "Id",
    "primary_key": "30",
    "column": "Content",
    "source_en": "The remnants of those shrouded under the mist,",
    "source_hash": "4959d9b3e0d4ebe6897b65530aebeeeefccba1ca",
    "category": "dialogue"
  },
  {
    "database": "lang_cgVideo.db",
    "table": "VideoCaption",
    "primary_key_column": "Id",
    "primary_key": "31",
    "column": "Content",
    "source_en": "Rage on and on……",
    "source_hash": "522db125714c443337144c23dc4c843c2f347533",
    "category": "dialogue"
  },
  {
    "database": "lang_cgVideo.db",
    "table": "VideoCaption",
    "primary_key_column": "Id",
    "primary_key": "32",
    "column": "Content",
    "source_en": "Look out!",
    "source_hash": "56ba018d13aabd1ce8cf6597a44ed2512e8d3ff9",
    "category": "dialogue"
  },
  {
    "database": "lang_cgVideo.db",
    "table": "VideoCaption",
    "primary_key_column": "Id",
    "primary_key": "33",
    "column": "Content",
    "source_en": "The Clarea……Its resurging!",
    "source_hash": "25ad466b89e1f3f2b9d456c85d6b970789a0e17f",
    "category": "dialogue"
  },
  {
    "database": "lang_cgVideo.db",
    "table": "VideoCaption",
    "primary_key_column": "Id",
    "primary_key": "34",
    "column": "Content",
    "source_en": "Have you seen my crown?",
    "source_hash": "fcbffdb3ab4ade457ae79338ef9e20e69f130b24",
    "category": "dialogue"
  },
  {
    "database": "lang_cgVideo.db",
    "table": "VideoCaption",
    "primary_key_column": "Id",
    "primary_key": "35",
    "column": "Content",
    "source_en": "A high class Calamon? No, wait……",
    "source_hash": "7e0354179be51128a2bb85bd8507fae29f263bcf",
    "category": "dialogue"
  },
  {
    "database": "lang_cgVideo.db",
    "table": "VideoCaption",
    "primary_key_column": "Id",
    "primary_key": "36",
    "column": "Content",
    "source_en": "I won't……Let you hurt anyone!",
    "source_hash": "e83c195caa1b0cc2aed15b1d491526b6c0bb58f4",
    "category": "dialogue"
  },
  {
    "database": "lang_cgVideo.db",
    "table": "VideoCaption",
    "primary_key_column": "Id",
    "primary_key": "37",
    "column": "Content",
    "source_en": "Yang, Yangyang!",
    "source_hash": "79a0112c52940b533453ee3f924a128c5d48ec9e",
    "category": "dialogue"
  },
  {
    "database": "lang_cgVideo.db",
    "table": "VideoCaption",
    "primary_key_column": "Id",
    "primary_key": "38",
    "column": "Content",
    "source_en": "Everyone……Run, hurry……",
    "source_hash": "7dc636676340aded9a0b5b4c7683e1aaef446d90",
    "category": "dialogue"
  },
  {
    "database": "lang_cgVideo.db",
    "table": "VideoCaption",
    "primary_key_column": "Id",
    "primary_key": "39",
    "column": "Content",
    "source_en": "Is there where the wind fades……",
    "source_hash": "8c2b93a791f6ea46ac4342cb0e97f78d8598a3ef",
    "category": "dialogue"
  },
  {
    "database": "lang_cgVideo.db",
    "table": "VideoCaption",
    "primary_key_column": "Id",
    "primary_key": "40",
    "column": "Content",
    "source_en": "Yang……Yangyang!",
    "source_hash": "63f88ec305e3d13563c5daa1e370ed2365f2288c",
    "category": "dialogue"
  },
  {
    "database": "lang_cgVideo.db",
    "table": "VideoCaption",
    "primary_key_column": "Id",
    "primary_key": "41",
    "column": "Content",
    "source_en": "This is getting rather dull.",
    "source_hash": "c5fa6553fb711fc92532c1ec0f4028f92b20dc1b",
    "category": "dialogue"
  },
  {
    "database": "lang_cgVideo.db",
    "table": "VideoCaption",
    "primary_key_column": "Id",
    "primary_key": "42",
    "column": "Content",
    "source_en": "Take it easy, you will feel nothing soon!",
    "source_hash": "279ac986b69ffb21956a9ee9c50d373475883279",
    "category": "dialogue"
  },
  {
    "database": "lang_cgVideo.db",
    "table": "VideoCaption",
    "primary_key_column": "Id",
    "primary_key": "43",
    "column": "Content",
    "source_en": "Ugh... Don't just leave this troublemaker to me!",
    "source_hash": "af0eb04406ed296d1d70c19581daca824221e634",
    "category": "dialogue"
  },
  {
    "database": "lang_cgVideo.db",
    "table": "VideoCaption",
    "primary_key_column": "Id",
    "primary_key": "44",
    "column": "Content",
    "source_en": "Fine. Follow me, and I'll show you around.",
    "source_hash": "722d04b09b2400ec308eef4d9fa9068444de293f",
    "category": "dialogue"
  },
  {
    "database": "lang_cgVideo.db",
    "table": "VideoCaption",
    "primary_key_column": "Id",
    "primary_key": "83",
    "column": "Content",
    "source_en": "No!",
    "source_hash": "1d59aef12a4ca164a928aff910b77fcf7bf27ec3",
    "category": "dialogue"
  }
]